rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 가족 코드(4자 이상)를 아는 기기만 그 가족의 데이터를 읽고 쓸 수 있음.
    // families 자체의 목록 조회, 컬렉션 그룹 조회는 어떤 규칙에도 해당하지 않아 모두 거부됨.
    match /families/{code}/{col}/{id} {
      allow read, write: if code.size() >= 4
        && col in ['meta', 'events', 'todos', 'gear'];
    }
  }
}
